{
  "$schema": "https://open-plugin-spec.org/schema/v1/plugin.json",
  "id": "com.qortroller.rig-steward",
  "name": "QorTroller Rig Steward",
  "version": "0.1.0",
  "description": "A sovereign-gaming operations agent for QorTroller — digests, diagnostics, and ceremony guidance without ever touching a key.",
  "author": "QorTroller Engineering",
  "license": "MIT",
  "homepage": "https://github.com/ConWan30/QorTroller/tree/main/buzz-persona-qortroller",
  "keywords": ["qortroller", "vapi", "gaming", "depin", "iotex", "ioid", "poac", "rig-ops"],
  "engines": {
    "buzz": ">=0.9.0"
  },
  "personas": [
    "agents/qortroller.persona.md"
  ],
  "pack_instructions": "instructions.md",
  "mcp_config": ".mcp.json",
  "defaults": {
    "model": "xai:grok-4.5",
    "temperature": 0.3,
    "max_context_tokens": 128000,
    "triggers": {
      "mentions": true,
      "keywords": ["qortroller", "rig", "session", "ioID", "PoAC", "VAPI", "invariant"],
      "all_messages": false
    },
    "subscribe": ["#rig-ops"],
    "thread_replies": true,
    "broadcast_replies": false
  }
}
