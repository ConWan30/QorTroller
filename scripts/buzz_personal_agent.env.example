# QorTroller Buzz Gamer Personal Agent — env template.
# Copy to a gamer-local .env (NEVER commit the real .env).
#
# This is the gamer-self key, separate from the operator @EA bot key.

# Gamer private key (nsec or hex). The agent signs replies with this.
# Generate with: cd buzz && cargo run -p buzz-admin -- generate-key
BUZZ_PRIVATE_KEY=

# Buzz relay. Local stack defaults to ws://localhost:3000 (NOT 8080).
BUZZ_RELAY_URL=ws://localhost:3000

# QorTroller bridge (gamer self-service read endpoints only).
BRIDGE_BASE_URL=http://localhost:8000

# Bridge read API key (optional — fail-open in dev; required if OPERATOR_API_KEY
# is set on the bridge). Used for x-api-key header.
BRIDGE_API_KEY=

# Agent identity.
# This is used in log messages and replies only. It does NOT overwrite your
# personal Buzz profile; set your own profile in the Buzz desktop.
# If you leave these empty, the agent loads displayName/about from the pack.
BUZZ_PERSONAL_AGENT_NAME=Retina
BUZZ_PERSONAL_AGENT_ABOUT=Gamer-facing self-service and agentic creation for QorTroller

# Optional: path to a Buzz agent snapshot .agent.json.
# If set, the agent loads its display name and about from the pack.
# BUZZ_PERSONAL_AGENT_PERSONA_PACK=buzz-persona-qortroller-concierge/qortroller-concierge.agent.json

# Optional: send a greeting to the configured DM(s) on startup.
# Set to 1 to enable. The default text mentions the Grok 4.5 persona pack.
# BUZZ_PERSONAL_AGENT_GREET_ON_START=0
# BUZZ_PERSONAL_AGENT_GREETING=Hello — I am your QorTroller Concierge, ready to help.

# Optional: comma-separated DM UUIDs to poll. If unset, the agent tries `buzz dms list`.
# In local dev, `dms list` often does not return DMs you are a participant in but did not
# create, so pre-configuring the DM id(s) is more reliable.
# BUZZ_PERSONAL_AGENT_DM_IDS=4bb155db-1708-4bbc-9103-a00ba1c649ac

# Lobby channel UUID. If set, the `claim` command will post the ioID claim to #lobby.
# BUZZ_LOBBY_CHANNEL_ID=e6f584b3-6c6c-40e4-948b-27acf8fa822e

# Brainstorm channel UUID. If set, the `brainstorm <topic>` command will post there.
# BUZZ_BRAINSTORM_CHANNEL_ID=49ad0e63-6d4d-4fb3-af3f-5b1067ed8d88

# Optional audit channel for agent birth announcements (used by `create agent`).
# BUZZ_AUDIT_CHANNEL_ID=

# Poll interval (seconds).
BUZZ_PERSONAL_AGENT_INTERVAL_S=10

# Fail-closed: must be 1 to start.
BUZZ_PERSONAL_AGENT_ENABLED=0

# Gamer ioID/device claims. These are posted to the user's own kind:0 profile.
# Real proof lives on IoTeX; these tags are self-asserted pointers.
PERSONAL_AGENT_IOID_TOKEN=498
PERSONAL_AGENT_DEVICE_ID=581a836c

# Buzz CLI binary (for DM polling and replies). Built from buzz/crates/buzz-cli.
# BUZZ_CLI_PATH=C:\Users\Contr\vapi-pebble-prototype\buzz\target\debug\buzz.exe

# Set to 1 to read DMs and print replies instead of sending them.
# BUZZ_PERSONAL_AGENT_DRY_RUN=0
