# QorTroller Buzz bot — Phase 1 env template.
# Copy to .env (NEVER commit the real .env).
#
# Generate the EA bot keypair with:
#   cd buzz && cargo run -p buzz-admin -- generate-key
# Save the secret immediately; it is not recoverable.

# EA bot identity (NOT derived from ioID tokenId 498).
BUZZ_PRIVATE_KEY=

# Owner-attested (NIP-OA) mode: the operator npub that vouches for the bot.
# Leave blank for standalone auth mode.
BUZZ_OWNER_PRIVATE_KEY=

# Buzz relay. Local stack defaults to ws://localhost:3000 (NOT 8080).
BUZZ_RELAY_URL=ws://localhost:3000

# Channels (UUIDs from the desktop app). Comma-separated.
BUZZ_CHANNEL_IDS=

# QorTroller bridge (for HardwareWatcher / BridgeClient reads).
BRIDGE_BASE_URL=http://localhost:8000

# Display name + about for the kind:0 profile.
QORTROLLER_BOT_NAME=QorTroller Rig EA
QORTROLLER_BOT_ABOUT=Operator steward: rig status + session digests. Proof lives in QorTroller, not chat.

# Device claim tags (asserted by the bot, NOT proof on the wire).
QORTROLLER_DEVICE_ID=581a836c
QORTROLLER_IOID_TOKEN=498
