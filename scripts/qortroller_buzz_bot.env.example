# QorTroller Buzz bot — Phase 1 env template.
# Copy to .env (NEVER commit the real .env).
#
# Generate the EA bot keypair with:
#   cd buzz && cargo run -p buzz-admin -- generate-key
# Save the secret immediately; it is not recoverable.

# EA bot identity (NOT derived from ioID tokenId 498).
BUZZ_PRIVATE_KEY=

# Owner-attested (NIP-OA) mode: the operator npub that vouches for the bot.
# Leave blank for standalone auth mode.
BUZZ_OWNER_PRIVATE_KEY=

# Precomputed NIP-OA auth tag (minted offline with `qortroller-buzz authtag`).
# When set, the helper includes the owner-attestation tag in every publish.
# The operator key is never in the bot's environment — only this tag.
# BUZZ_AUTH_TAG=["auth","<owner-pubkey-hex>","","<sig-hex>"]

# Buzz relay. Local stack defaults to ws://localhost:3000 (NOT 8080).
BUZZ_RELAY_URL=ws://localhost:3000

# Channels (UUIDs from the desktop app). Comma-separated.
# rig-ops channel(s) for status; matches channel for session postcards.
BUZZ_CHANNEL_IDS=
# Matches channel — where session postcards (§3.2) are published for pinning.
# Leave blank to post digests to the first BUZZ_CHANNEL_IDS channel.
BUZZ_MATCHES_CHANNEL_ID=

# QorTroller bridge (for HardwareWatcher / BridgeClient reads).
BRIDGE_BASE_URL=http://localhost:8000

# Bridge read API key (optional — fail-open in dev; required if OPERATOR_API_KEY
# is set on the bridge). The bot passes this as the x-api-key header for
# /player/session-status and other read endpoints.
BRIDGE_API_KEY=

# Rust helper binary (signs + publishes kind 9 events). Built from
# buzz/examples/qortroller-buzz. Default points to the debug build.
# BUZZ_HELPER_PATH=C:\Users\Contr\vapi-pebble-prototype\buzz\target\debug\qortroller-buzz.exe

# Buzz CLI binary (for `buzz messages get` command polling). Built from
# buzz/crates/buzz-cli. Leave unset to disable command polling (status-only).
# BUZZ_CLI_PATH=C:\Users\Contr\vapi-pebble-prototype\buzz\target\debug\buzz.exe

# Poll intervals (seconds). Status publishes on state change or every
# BUZZ_STATUS_INTERVAL. Commands are polled every BUZZ_COMMAND_POLL_INTERVAL.
# Session digests (§3.2 postcards) publish on verdict/flag change or every
# BUZZ_SESSION_DIGEST_INTERVAL.
BUZZ_STATUS_INTERVAL=30
BUZZ_COMMAND_POLL_INTERVAL=10
BUZZ_SESSION_DIGEST_INTERVAL=120

# Display name + about for the kind:0 profile.
QORTROLLER_BOT_NAME=QorTroller Rig EA
QORTROLLER_BOT_ABOUT=Operator steward: rig status + session digests. Proof lives in QorTroller, not chat.

# Device claim tags (asserted by the bot, NOT proof on the wire).
QORTROLLER_DEVICE_ID=581a836c
QORTROLLER_IOID_TOKEN=498
