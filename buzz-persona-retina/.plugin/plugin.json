{
  "$schema": "https://open-plugin-spec.org/schema/v1/plugin.json",
  "id": "com.qortroller.retina",
  "name": "QorTroller Retina Specialist",
  "version": "0.1.0",
  "description": "Retina / VSS session-integrity specialist for QorTroller. Explains, diagnoses, and calls devin @EA commands.",
  "author": "QorTroller Engineering",
  "license": "MIT",
  "homepage": "https://github.com/ConWan30/QorTroller/tree/main/buzz-persona-retina",
  "keywords": ["qortroller", "retina", "vss", "poac", "vlm", "session", "oracle"],
  "engines": {
    "buzz": ">=0.9.0"
  },
  "personas": [
    "agents/retina.persona.md"
  ],
  "pack_instructions": "instructions.md",
  "mcp_config": ".mcp.json",
  "defaults": {
    "model": "xai:grok-4.5",
    "temperature": 0.3,
    "max_context_tokens": 128000,
    "triggers": {
      "mentions": true,
      "keywords": ["retina", "oracle", "vss", "vlm", "session", "verify", "poac", "l4", "l5", "l6", "separation", "postcard", "verdict"],
      "all_messages": false
    },
    "subscribe": ["#rig-ops", "#matches", "#lobby"],
    "thread_replies": true,
    "broadcast_replies": false
  }
}
